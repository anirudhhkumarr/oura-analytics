# Create an Oura OAuth application at https://cloud.ouraring.com/oauth/applications
# Only the Client ID is needed (implicit grant). Optional at build time:
VITE_OURA_CLIENT_ID=
# Register the exact page URL as the Redirect URI, e.g.:
#   https://anirudhhkumarr.github.io/oura-analytics/
#   http://localhost:5173/
# Optional: same-origin or CORS-enabled API base (defaults to https://api.ouraring.com in production).
# VITE_OURA_API_BASE=
